# Ignore the workspace layout (the main culprit of merge conflicts)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Ignore the cache and indexed database
.obsidian/cache/
.obsidian/indexedDWB/

# Ignore plugin binaries — Obsidian downloads these automatically
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css
.obsidian/plugins/*/obsidian_askpass.sh

# Optional: Ignore community plugin storage if it's too noisy
# .obsidian/plugins/*/data.json