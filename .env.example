# Copy to .env and fill in values. .env is gitignored — never commit it.

# Ollama
OLLAMA_HOST=
OLLAMA_PORT=
OLLAMA_API_KEY=

# Qdrant
QDRANT_HOST=
QDRANT_PORT=
QDRANT_API_KEY=

# Vikunja MCP (.mcp.json reads these — base URL only, no /api/v1)
VIKUNJA_URL=
VIKUNJA_TOKEN=

# ntfy
NTFY_URL=
NTFY_TOPIC=second-brain

# RAG tuning (optional — defaults shown)
RAG_COLLECTION=second_brain
RAG_EMBED_MODEL=embeddinggemma:latest
RAG_QUERY_LIMIT=10
RAG_MAX_FILES=3
RAG_SCORE_THRESHOLD=0.30
RAG_TIMEOUT=5

# Hook budget (optional — defaults shown)
# Hard limit per file in chars; CI fails above this. Warn threshold as percentage (0-100).
HOOK_BUDGET_HARD=10000
HOOK_BUDGET_WARN_PCT=80

# ntfy notification toggles (optional — defaults shown)
# Set to false to silence a specific notification point while keeping ntfy configured.
NTFY_ON_EVENTS=true
NTFY_ON_HEALTH=true
