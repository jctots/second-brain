# Copy to .env and fill in values. .env is gitignored — never commit it.

# Ollama
OLLAMA_HOST=
OLLAMA_PORT=
OLLAMA_API_KEY=

# Qdrant
QDRANT_HOST=
QDRANT_PORT=
QDRANT_API_KEY=

# Vikunja MCP (.mcp.json reads these — base URL only, no /api/v1)
VIKUNJA_URL=
VIKUNJA_TOKEN=

# ntfy
NTFY_URL=
NTFY_TOPIC=second-brain

# RAG tuning (optional — defaults shown)
RAG_COLLECTION=second_brain
RAG_EMBED_MODEL=embeddinggemma:latest
RAG_QUERY_LIMIT=10
RAG_MAX_FILES=3
RAG_SCORE_THRESHOLD=0.30
RAG_TIMEOUT=5

# Hook budget (optional — defaults shown)
# Two different thresholds:
#   HOOK_OUTPUT_CAP  — runtime. Claude Code truncates a hook's whole stdout at 10,000
#                      chars; past this an injector emits a pointer line instead, so the
#                      failure is visible rather than a silent preview.
#   HOOK_BUDGET_HARD — maintenance target. CI fails above this. Counts the label each
#                      injector prepends, not just the file body.
HOOK_OUTPUT_CAP=9800
HOOK_BUDGET_HARD=9000
HOOK_BUDGET_WARN_PCT=80

# ntfy notification toggles (optional — defaults shown)
# Set to false to silence a specific notification point while keeping ntfy configured.
NTFY_ON_EVENTS=true
NTFY_ON_HEALTH=true
