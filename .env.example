# Copy to .env and fill in values. .env is gitignored — never commit it.

# Ollama
OLLAMA_HOST=
OLLAMA_PORT=
OLLAMA_API_KEY=

# Qdrant
QDRANT_HOST=
QDRANT_PORT=
QDRANT_API_KEY=

# RAG tuning (optional — defaults shown)
RAG_COLLECTION=second_brain
RAG_EMBED_MODEL=embeddinggemma:latest
RAG_QUERY_LIMIT=10
RAG_MAX_FILES=3
RAG_SCORE_THRESHOLD=0.30
RAG_TIMEOUT=5
